{
  "name": "react-phase",
  "version": "1.0.0",
  "description": "A phase-first lifecycle abstraction for React",
  "keywords": [
    "react",
    "hooks",
    "lifecycle",
    "useEffect",
    "phase",
    "async"
  ],
  "author": "b-balakrishna",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.0.0",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "react": "^18.0.0",
    "react-dom": "^18.3.1",
    "terser": "^5.48.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.7"
  }
}
